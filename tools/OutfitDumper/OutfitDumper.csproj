<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>OutfitDumper</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Where the game and your r2modman profile live -->
    <GameDir>C:\Program Files (x86)\Steam\steamapps\common\How to Fish\How to Fish</GameDir>
    <Managed>$(GameDir)\How to Fish_Data\Managed</Managed>
    <ProfileDir>$(APPDATA)\r2modmanPlus-local\HowToFish\profiles\Default</ProfileDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lets us read the game's private fields directly -->
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.2" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="$(ProfileDir)\BepInEx\core\BepInEx.dll" Private="false" />
    <Reference Include="$(ProfileDir)\BepInEx\core\0Harmony.dll" Private="false" />
    <Reference Include="$(Managed)\Assembly-CSharp.dll" Private="false" Publicize="true" />
    <Reference Include="$(Managed)\FishNet.Runtime.dll" Private="false" />
    <Reference Include="$(Managed)\UnityEngine.dll" Private="false" />
    <Reference Include="$(Managed)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="$(Managed)\UnityEngine.PhysicsModule.dll" Private="false" />
    <Reference Include="$(Managed)\Unity.Localization.dll" Private="false" />
    <Reference Include="$(Managed)\UnityEngine.ImageConversionModule.dll" Private="false" />
    <Reference Include="$(Managed)\Unity.InputSystem.dll" Private="false" />
    <Reference Include="$(Managed)\UnityEngine.AnimationModule.dll" Private="false" />
  </ItemGroup>

  <!-- After building, copy the DLL straight into the r2modman profile so you can just launch the game -->
  <Target Name="CopyToProfile" AfterTargets="Build">
    <MakeDir Directories="$(ProfileDir)\BepInEx\plugins\OutfitDumper" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ProfileDir)\BepInEx\plugins\OutfitDumper" />
  </Target>


</Project>
